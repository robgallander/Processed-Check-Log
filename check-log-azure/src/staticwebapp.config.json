{
  "routes": [
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/api/hubspot/webhook", "methods": ["POST"], "allowedRoles": ["anonymous"] },
    { "route": "/403.html", "allowedRoles": ["authenticated"] },
    { "route": "/api/data/*", "methods": ["POST", "PUT", "PATCH", "DELETE"], "allowedRoles": ["checklog-editor"] },
    { "route": "/*", "allowedRoles": ["checklog-editor", "checklog-viewer"] }
  ],
  "responseOverrides": {
    "401": { "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer", "statusCode": 302 },
    "403": { "rewrite": "/403.html" }
  },
  "globalHeaders": {
    "Cache-Control": "no-store",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin"
  },
  "platform": { "apiRuntime": "node:20" }
}
